#: packaging/freedesktop/re.fossplant.songrec.desktop:18
msgid "An open-source Shazam client for Linux, written in Rust"
msgstr ""

#: packaging/freedesktop/re.fossplant.songrec.desktop:20
msgid "Rust;GTK;Shazam;Client;Audio;Song;Recognition;Fingerprinting;"
msgstr ""

#: packaging/freedesktop/re.fossplant.songrec.metainfo.xml:11
msgid "Recognize songs from audio easily"
msgstr ""

#: packaging/freedesktop/re.fossplant.songrec.metainfo.xml:13
msgid ""
"SongRec is an unofficial Shazam client for Linux, written in Rust. It allows "
"you to easily recognize songs from your speakers, microphone or audio files."
msgstr ""

#: packaging/freedesktop/re.fossplant.songrec.metainfo.xml:14
msgid "Features:"
msgstr ""

#: packaging/freedesktop/re.fossplant.songrec.metainfo.xml:15
msgid "- Recognize tracks from an arbitrary audio file."
msgstr ""

#: packaging/freedesktop/re.fossplant.songrec.metainfo.xml:16
msgid "- Recognize audio from the microphone."
msgstr ""

#: packaging/freedesktop/re.fossplant.songrec.metainfo.xml:17
msgid "- Usage from both GUI and command line."
msgstr ""

#: packaging/freedesktop/re.fossplant.songrec.metainfo.xml:18
msgid ""
"- Provide an history of the recognized songs on the GUI, exportable to CSV."
msgstr ""

#: packaging/freedesktop/re.fossplant.songrec.metainfo.xml:19
msgid ""
"- Continuous song detection from the microphone, with the ability to choose "
"your input device."
msgstr ""

#: packaging/freedesktop/re.fossplant.songrec.metainfo.xml:20
msgid ""
"- Ability to recognize songs from your speakers rather than your microphone."
msgstr ""

